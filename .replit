modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["yarn", "cache", "clean"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "NODEJS"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
